{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NaukriSupportAgentResponse",
  "description": "Structured output schema validated on every Naukri.com Support Agent response (Task 9).",
  "type": "object",
  "required": [
    "answer",
    "route",
    "sources",
    "grounded",
    "guardrail_flags",
    "trace_id",
    "confidence"
  ],
  "properties": {
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "type": "string",
      "enum": ["rag", "status"]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grounded": {
      "type": "boolean"
    },
    "guardrail_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "tool_result": {
      "type": ["object", "null"]
    },
    "conversation_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
